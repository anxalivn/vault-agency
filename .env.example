# Copy this file to .env.local and fill in your real values.
# Every field here has a fallback placeholder baked into src/lib/content.ts, so the site
# builds and runs fine even if you leave some of these unset — but nothing here will show
# up as "real" until you set it.
#
# After editing .env.local, restart `npm run dev` (env vars are only read at build/start).

# --- Site basics -------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=
# Your real production domain, no trailing slash. Drives canonical URLs, og:image, the sitemap
# and structured data, so share previews point at the wrong place until this is set.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# --- Booking -------------------------------------------------------------
# Optional: leave blank to use the default in src/lib/content.ts (DEFAULT_CALENDLY_URL).
NEXT_PUBLIC_CALENDLY_URL=

# --- Contact -------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
# Phone, and the social URLs below, are only added to search-engine structured data when set.
NEXT_PUBLIC_CONTACT_PHONE=

# --- Social links -------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Images -------------------------------------------------------------
# Full URLs (e.g. hosted on your CDN / image host) or absolute paths to files you've
# dropped in the public/ folder (e.g. /proofs/proof-1.jpg). Leave blank to show the
# built-in styled placeholder instead.
NEXT_PUBLIC_PROOF_IMAGE_1=
NEXT_PUBLIC_PROOF_IMAGE_2=
NEXT_PUBLIC_PROOF_IMAGE_3=
NEXT_PUBLIC_ABOUT_IMAGE=

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
# When set, page views are tracked automatically and a "generate_lead" event fires when a
# Calendly call is booked (mark it as a key event in GA4).
NEXT_PUBLIC_GA_ID=
